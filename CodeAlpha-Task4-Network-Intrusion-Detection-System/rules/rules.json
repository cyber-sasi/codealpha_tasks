{
  "rules": [
    {
      "id": "PORT_SCAN",
      "description": "Possible TCP port scan",
      "severity": "MEDIUM",
      "threshold": 5,
      "window_seconds": 10,
      "enabled": true
    },
    {
      "id": "CONNECTION_FLOOD",
      "description": "Possible repeated TCP connection attempts to one destination",
      "severity": "HIGH",
      "threshold": 20,
      "window_seconds": 10,
      "enabled": true
    },
    {
      "id": "ICMP_ANOMALY",
      "description": "Possible unusually frequent ICMP traffic",
      "severity": "MEDIUM",
      "threshold": 30,
      "window_seconds": 10,
      "enabled": true
    },
    {
      "id": "REPEATED_PATTERN",
      "description": "Repeated traffic pattern anomaly",
      "severity": "LOW",
      "threshold": 12,
      "window_seconds": 5,
      "enabled": true
    }
  ]
}
